# The Milestone 1 handoff ships a PREBUILT kernel, not its source, so there is
# nothing to compile here. Boot the system with the scripts at the repo root:
#   ../boot.sh        single node
#   ../boot-gdb.sh    single node, halted for the debugger
# and run the ring with:  .venv/bin/python server/distinf_sim.py --workers 2 --model 1
all:
	@echo "This tree is prebuilt. Use ../boot.sh (see the stub target for details)."; exit 1
