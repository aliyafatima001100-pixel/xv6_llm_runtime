# ===========================================
#  Build Artifacts (C / C++)
# ===========================================
# Object and binary files
*.o
*.a
*.so
*.out
*.exe
*.hex

# Compiled binaries from llama2c builds
run
runq
bench_*
test_*

# ===========================================
#  LLaMA2C Project-Specific
# ===========================================
# Model binaries and checkpoints — heavy, not for git
llama2c/models/

# NO checkpoint is tracked. stories110M.bin alone is 418 MiB, past GitHub's 100 MB
# per-file hard limit, and all three together are 495 MB against 18 MB for the rest
# of the tree. Fetch them with ./fetch-models.sh (see server/models/README.md).
server/models/*.bin

# Raw perf data (binary profiling traces)
perf.data
perf.data.old

# ===========================================
#  Editor and Environment Files
# ===========================================
.vscode/
.idea/
*.code-workspace
.temp/

# ===========================================
#  Python Helper Scripts (if any)
# ===========================================
__pycache__/
*.pyc
.venv/
venv/

# ===========================================
#  Other script files
# ===========================================
*.sh

# ===========================================
#  Temporary and Log Files
# ===========================================
*.tmp
logs/

# ===========================================
#  Keep Useful Data / Reports
# ===========================================
# Keep all results/ files (do NOT ignore results/)
# Keep text and CSV outputs
!*.txt
!*.csv

# ===========================================
#  Documentation Files
# ===========================================
# Ignore Temporarily 
docs/

# ===========================================
#  End of .gitignore
# ===========================================

# ===========================================
#  Shipped artifacts (Milestone 1 handoff)
# ===========================================
# This tree DISTRIBUTES prebuilt binaries and its own launch scripts; the generic
# rules above would drop them from a clone, leaving a student with no way to boot.
# Re-include them explicitly. (The `*.sh` rule above is what hides the boot scripts.)
!boot.sh
!boot-gdb.sh
!fetch-models.sh
